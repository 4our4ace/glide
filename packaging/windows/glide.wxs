<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Glide"
    Manufacturer="Glide"
    Version="$(var.Version)"
    UpgradeCode="{7A4F2C81-9E3B-4D12-B65A-2C8E4F1D9B03}"
    Scope="perUser"
    InstallerVersion="500"
    Compressed="yes">

    <!-- Allow upgrades, same-version Nightly reinstalls, and Nightly <-> Stable switching. -->
    <MajorUpgrade
      AllowDowngrades="yes"
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="GlideIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="GlideIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/4our4ace/glide" />
    <Property Id="ARPHELPLINK" Value="https://github.com/4our4ace/glide/issues" />
    <Property Id="ARPCOMMENTS" Value="Zero-cloud software KVM for Windows 11 and Linux" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Glide" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Glide" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Glide" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <ComponentGroup Id="AppComponents">
      <!-- Main executable installed per-user in %LOCALAPPDATA%\Programs\Glide\glide.exe (no UAC needed). -->
      <Component Id="GlideExecutable" Directory="INSTALLFOLDER" Guid="{E41C68B2-5A09-4F7D-8C23-19B7D4E50A11}">
        <RegistryValue
          Root="HKCU"
          Key="Software\Glide\Installer"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
        <File
          Id="GlideExe"
          Name="glide.exe"
          Source="$(var.ExePath)"
          KeyPath="no" />
        <RemoveFile Id="RemoveOldExe" Name="glide.exe.old" On="both" />
        <RemoveFile Id="RemoveStagedExe" Name="glide.exe.new.*" On="both" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>

      <!-- Add %LOCALAPPDATA%\Programs\Glide to the current user's PATH for CLI access. -->
      <Component Id="GlideUserPath" Directory="INSTALLFOLDER" Guid="{5B9D3A17-7C42-48E6-A1F5-8D2C6E9B0432}">
        <RegistryValue
          Root="HKCU"
          Key="Software\Glide\Installer"
          Name="PathEntry"
          Type="integer"
          Value="1"
          KeyPath="yes" />
        <Environment
          Id="PATH"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="no" />
      </Component>

      <!-- Start Menu shortcut pointing to %LOCALAPPDATA%\Programs\Glide\glide.exe. -->
      <Component Id="GlideStartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="{93F7E241-1D85-4B0A-9E6C-4A7B2F8D1C55}">
        <RegistryValue
          Root="HKCU"
          Key="Software\Glide\Installer"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
        <Shortcut
          Id="GlideStartMenuLnk"
          Name="Glide"
          Description="Glide Software KVM"
          Target="[INSTALLFOLDER]glide.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="GlideIcon.ico" />
        <RemoveFolder Id="RemoveStartMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
